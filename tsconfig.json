{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@styles/*": ["src/styles/*"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*.astro", "src/**/*.ts"],
  "exclude": ["dist", "node_modules", "js", "less", "Gruntfile.js"]
}
