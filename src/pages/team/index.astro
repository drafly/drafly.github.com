---
import SiteLayout from "../../layouts/SiteLayout.astro";
import InnerHero from "../../components/InnerHero.astro";
import { team, gradYear, isGraduated } from "../../data/site";

const graduated = team.filter(isGraduated);
const active = team.filter((member) => member.category !== "visitor-intern" && !isGraduated(member));
const visitorsAndInterns = team.filter((member) => member.category === "visitor-intern");
---

<SiteLayout
  title="团队 · MAGIC Lab"
  description="北京工商大学 MAGIC 实验室成员。"
>
  <main class="inner-page">
    <InnerHero
      index="MAGIC 实验室 / TEAM"
      title="让好奇，经得起验证"
      lead="围绕医学视觉与智能成像协作探索，也重视每位成员从问题定义、实验设计到成果表达的完整成长。"
      facts="独立思考 · 开放协作 · 长期成长"
      image="/img/hero/team-comic-portrait.png"
      imageAlt="韩龙飞与医学人工智能研究元素的漫画风插画"
      imageLabel="THINK / BUILD / GROW"
      imageFit="cover"
    />

    <section class="team-section" id="team">
      <div class="site-shell">
        <div class="team-intro" data-reveal>
          <div>
            <p>共同成长</p>
            <h2>一起提出问题，<br />也一起验证答案。</h2>
          </div>
          <div class="team-intro__summary">
            <aside class="team-name-story" aria-labelledby="team-name-story-title">
              <p>WHY MAGIC</p>
              <h3 id="team-name-story-title" lang="en">
                Medical AI Group for Imaging and Computing
              </h3>
              <p>
                MAGIC 代表我们围绕医学人工智能、视觉成像与计算方法开展研究，
                也代表一群因好奇心相聚、在协作中探索和成长的人。
              </p>
            </aside>
          </div>
        </div>

        <dl class="team-paths" aria-label="MAGIC 实验室研究与成长路径" data-reveal>
          <div>
            <dt>研究起点</dt>
            <dd>从真实问题出发</dd>
            <dd>明确问题定义</dd>
          </div>
          <div>
            <dt>工作过程</dt>
            <dd>让方法与实验相互验证</dd>
            <dd>完成设计、实现与复盘</dd>
          </div>
          <div>
            <dt>成长目标</dt>
            <dd>形成独立研究能力</dd>
            <dd>做出可信、清楚的研究</dd>
          </div>
        </dl>

        {active.length > 0 && (
          <section class="team-cohort" aria-labelledby="team-active-heading">
            <div class="team-cohort__head">
              <div>
                <h3 id="team-active-heading">在读</h3>
                <p>学制 3 年 · 在 MAGIC 实验室共同探索医学人工智能。</p>
              </div>
              <span class="team-cohort__count">{String(active.length).padStart(2, "0")}</span>
            </div>
            <div class="team-grid">
              {active.map((member) => (
                <article class="team-member" data-reveal>
                  <div class="team-member__image">
                    <img
                      src={member.image.src}
                      alt={`${member.name}（${member.chineseName}）`}
                      width={member.image.width}
                      height={member.image.height}
                    />
                    <span aria-hidden="true">{member.enrolled}</span>
                  </div>
                  <div class="team-member__meta">
                    <p>{member.program} · {member.enrolled}–在读</p>
                    <h3>{member.name} <span lang="zh-CN">{member.chineseName}</span></h3>
                    {member.email ? (
                      <a href={`mailto:${member.email}`} aria-label={`给 ${member.name} 发邮件`}>
                        <span>{member.email}</span>
                        <span aria-hidden="true">↗</span>
                      </a>
                    ) : (
                      <p class="team-member__contact-pending">邮箱待更新</p>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}

        {visitorsAndInterns.length > 0 && (
          <section class="team-cohort" aria-labelledby="team-visitor-intern-heading">
            <div class="team-cohort__head">
              <div>
                <h3 id="team-visitor-intern-heading">访问与实习</h3>
                <p>短期加入 MAGIC 实验室，在真实研究任务中学习、协作与实践。</p>
              </div>
              <span class="team-cohort__count">{String(visitorsAndInterns.length).padStart(2, "0")}</span>
            </div>
            <div class="team-grid">
              {visitorsAndInterns.map((member) => (
                <article class="team-member" data-reveal>
                  <div class="team-member__image">
                    <img
                      src={member.image.src}
                      alt={`${member.name}（${member.chineseName}）`}
                      width={member.image.width}
                      height={member.image.height}
                    />
                    <span aria-hidden="true">{member.enrolled}</span>
                  </div>
                  <div class="team-member__meta">
                    <p>{member.program} · {member.enrolled}–访问 / 实习</p>
                    <h3>{member.name} <span lang="zh-CN">{member.chineseName}</span></h3>
                    {member.email ? (
                      <a href={`mailto:${member.email}`} aria-label={`给 ${member.name} 发邮件`}>
                        <span>{member.email}</span>
                        <span aria-hidden="true">↗</span>
                      </a>
                    ) : (
                      <p class="team-member__contact-pending">邮箱待更新</p>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}

        {graduated.length > 0 && (
          <section class="team-cohort" aria-labelledby="team-graduated-heading">
            <div class="team-cohort__head">
              <div>
                <h3 id="team-graduated-heading">已毕业</h3>
                <p>从 MAGIC 实验室出发，继续各自的学术与职业旅程。</p>
              </div>
              <span class="team-cohort__count">{String(graduated.length).padStart(2, "0")}</span>
            </div>
            <div class="team-grid">
              {graduated.map((member) => (
                <article class="team-member" data-reveal>
                  <div class="team-member__image">
                    <img
                      src={member.image.src}
                      alt={`${member.name}（${member.chineseName}）`}
                      width={member.image.width}
                      height={member.image.height}
                    />
                    <span aria-hidden="true">{member.enrolled}</span>
                  </div>
                  <div class="team-member__meta">
                    <p>{member.program} · {member.enrolled}–{gradYear(member)}</p>
                    <h3>{member.name} <span lang="zh-CN">{member.chineseName}</span></h3>
                    {member.email ? (
                      <a href={`mailto:${member.email}`} aria-label={`给 ${member.name} 发邮件`}>
                        <span>{member.email}</span>
                        <span aria-hidden="true">↗</span>
                      </a>
                    ) : (
                      <p class="team-member__contact-pending">邮箱待更新</p>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}

        <p class="team-roster-note" data-reveal>
          毕业时间按学制 3 年自动推算，以 MAGIC 实验室原始名册为准。
        </p>
      </div>
    </section>
  </main>
</SiteLayout>
