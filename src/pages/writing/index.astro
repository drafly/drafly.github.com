---
import SiteLayout from "../../layouts/SiteLayout.astro";
import InnerHero from "../../components/InnerHero.astro";
import { getCollection } from "astro:content";

const formatDate = (date: Date) =>
  `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;

const posts = (await getCollection("writing", ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
---

<SiteLayout
  title="博文 · Longfei Han"
  description="韩龙飞关于研究与工作关键思路的总结和分享。"
>
  <main class="inner-page">
    <InnerHero
      index="研究笔记 / WRITING"
      title="把复杂方法，写成可复用的理解"
      lead="从公式推导到代码验证，记录研究和工作中的关键思路，在持续总结与分享中，让零散经验沉淀为可复用、可交流的知识。"
      facts={`${posts.length} 篇博文 · 总结 · 分享 · 实践`}
      image="/img/hero/writing-math-derivation.png"
      imageAlt="从数学推导、凸优化轨迹到神经网络实验验证的研究流程"
      imageLabel="SUMMARIZE / SHARE / PRACTICE"
    />

    <section class="writing-archive">
      <div class="site-shell">
        {posts.length > 0 ? (
          <div class="post-list-v2">
            {posts.map((post) => (
              <a
                class="post-row-v2 post-row-v2--link"
                href={`/writing/${post.slug}/`}
              >
                <time>{formatDate(post.data.publishedAt)}</time>
                <span>{post.data.title}</span>
                <span>
                  {post.data.categories[0] ?? "博文"} <span aria-hidden="true">→</span>
                </span>
              </a>
            ))}
          </div>
        ) : (
          <div class="writing-empty">
            <p class="writing-empty__kicker">博文迁移中</p>
            <h3>历史博文正在陆续迁移。</h3>
            <p>
              旧站博文将分批迁入本站，第一批文章很快就会与大家见面。
            </p>
          </div>
        )}
      </div>
    </section>
  </main>
</SiteLayout>
