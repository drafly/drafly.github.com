---
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
import { siteCopy, type Locale } from "../i18n/home";

interface Props {
  title: string;
  description: string;
  lang?: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const {
  title,
  description,
  lang = "zh",
  alternates
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const copy = siteCopy[lang];
const zhAlternate = alternates?.zh ? new URL(alternates.zh, Astro.site) : undefined;
const enAlternate = alternates?.en ? new URL(alternates.en, Astro.site) : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    {zhAlternate && <link rel="alternate" hreflang="zh-CN" href={zhAlternate} />}
    {enAlternate && <link rel="alternate" hreflang="en" href={enAlternate} />}
    {zhAlternate && <link rel="alternate" hreflang="x-default" href={zhAlternate} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&family=Noto+Serif+SC:wght@400;600&family=Lora:wght@400;600&family=Open+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="home-v2">
    <SiteNav lang={lang} />
    <slot />

    <footer class="footer-v2">
      <div class="site-shell footer-v2__inner">
        <p>© {new Date().getFullYear()} {copy.footerName}</p>
        <p>{copy.footerMotto}</p>
      </div>
    </footer>

    <script src="../scripts/site-v2.js"></script>
  </body>
</html>
