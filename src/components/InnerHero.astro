---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  index: string;
  title: string;
  lead: string;
  image: string | ImageMetadata;
  imageAlt: string;
  imageLabel: string;
  facts: string;
  imageFit?: "cover" | "contain";
}

const {
  index,
  title,
  lead,
  image,
  imageAlt,
  imageLabel,
  facts,
  imageFit = "contain"
} = Astro.props;
---

<header class="inner-hero">
  <div class="inner-hero__grid" aria-hidden="true"></div>
  <div class="site-shell inner-hero__content" data-reveal>
    <div class="inner-hero__copy">
      <p class="inner-hero__index">{index}</p>
      <h1>{title}</h1>
      <p class="inner-hero__lead">{lead}</p>
      <p class="inner-hero__facts">{facts}</p>
    </div>
    <figure class:list={["inner-hero__media", `inner-hero__media--${imageFit}`]}>
      {typeof image === "string" ? (
        <img src={image} alt={imageAlt} loading="eager" decoding="async" fetchpriority="high" />
      ) : (
        <Image
          src={image}
          alt={imageAlt}
          widths={[480, 720, 960]}
          sizes="(max-width: 760px) calc(100vw - 40px), 44vw"
          format="webp"
          quality={82}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      )}
      <figcaption>{imageLabel}</figcaption>
    </figure>
  </div>
</header>
