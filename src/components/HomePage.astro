  googlescholar:
    "M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z",
  dblp:
    "M3.075.002c-.096.013-.154.092-.094.31L4.97 7.73 3.1 8.6s-.56.26-.4.85l2.45 9.159s.16.59.72.33l6.169-2.869 1.3-.61s.52-.24.42-.79l-.01-.06-1.13-4.22-.658-2.45-.672-2.49v-.04s-.16-.59-.84-1L3.5.141s-.265-.16-.425-.139zM18.324 5.03a.724.724 0 0 0-.193.06l-5.602 2.6.862 3.2 1.09 4.08.01.06c.05.47-.411.79-.411.79l-1.88.87.5 1.89.04.1c.07.17.28.6.81.91l6.95 4.269s.68.41.52-.17l-1.981-7.4 1.861-.86s.56-.26.4-.85L18.85 5.42s-.116-.452-.526-.39z",
  orcid:
    "M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-4.097-3.722h-2.222z",
  gitee:
    "M11.984 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.016 0zm6.09 5.333c.328 0 .593.266.592.593v1.482a.594.594 0 0 1-.593.592H9.777c-.982 0-1.778.796-1.778 1.778v5.63c0 .327.266.592.593.592h5.63c.982 0 1.778-.796 1.778-1.778v-.296a.593.593 0 0 0-.592-.593h-4.15a.592.592 0 0 1-.592-.592v-1.482a.593.593 0 0 1 .593-.592h6.815c.327 0 .593.265.593.592v3.408a4 4 0 0 1-4 4H5.926a.593.593 0 0 1-.593-.593V9.778a4.444 4.444 0 0 1 4.445-4.444h8.296Z"
};
---

<SiteLayout
  title={copy.metaTitle}
  description={copy.metaDescription}
  lang={lang}
  alternates={{ zh: "/", en: "/en/" }}
>
  <main class="home-layout">
    <aside class="profile-sidebar" data-reveal>
      <Image
        class="profile-sidebar__avatar"
        src={profile.avatar}
        alt={copy.portraitAlt}
        widths={[240, 320, 480]}
        sizes="(max-width: 900px) 180px, 240px"
        format="webp"
        quality={84}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <h1 class="profile-sidebar__name">
        {isEnglish ? profile.name.en : profile.name.zh}
        <span class="profile-sidebar__name-en" lang={isEnglish ? "zh-CN" : "en"}>
          {isEnglish ? profile.name.zh : profile.name.en}
        </span>
      </h1>
      <p class="profile-sidebar__role">{copy.role}</p>
      <p class="profile-sidebar__org">{copy.organization}</p>

      <div class="profile-sidebar__block">
        <span class="profile-sidebar__title">{copy.contactTitle}</span>
        <ul class="profile-sidebar__contact">
          <li>
            <span>{copy.emailLabel}</span>
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </li>
          <li>
            <span>{copy.addressLabel}</span>
            <span>{copy.location}</span>
          </li>
        </ul>
      </div>

      {profile.social.length > 0 && (
        <div class="profile-sidebar__block">
          <span class="profile-sidebar__title">{copy.academicLinksTitle}</span>
          <div class="profile-sidebar__social">
            {profile.social.map((link) => (
              <a href={link.url} rel="noreferrer">
                <span class="profile-sidebar__social-label">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d={socialIcons[link.icon]} />
                  </svg>
                  <span>{link.label}</span>
                </span>
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="profile-sidebar__block">
        <span class="profile-sidebar__title">{copy.interestsTitle}</span>
        <div class="interest-tags">
          {copy.interests.map((interest) => <span>{interest}</span>)}
        </div>
      </div>
    </aside>

    <div class="content-main">
      <section class="home-section" id="biography">
        <h2>{copy.biographyTitle}</h2>
        <div class="bio-copy" data-reveal set:html={copy.biography} />
        <div class="bio-actions" data-reveal>
          <a class="button-v2 button-v2--primary" href={`mailto:${profile.email}`}>
            {copy.contactAction} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <section class="home-section" id="research">
        <h2>{copy.researchTitle}</h2>
        <div class="direction-grid" data-reveal>
          {copy.directions.map((direction) => (
            <article class="direction-card">
              <span>{direction.index}</span>
              <h3>{direction.title}</h3>
              <p>{direction.text}</p>
            </article>
          ))}
        </div>
        <p class="lab-note" data-reveal>
          {copy.recruitmentPrefix}{" "}
          <a href={`mailto:${profile.email}`}>{profile.email}</a>{isEnglish ? "." : "。"}
        </p>
      </section>

      <section class="home-section" id="news">
        <h2>{copy.newsTitle}</h2>
        <ul class="news-list" data-reveal>
          {copy.news.map((item) => (
            <li>
              <time>{item.date}</time>
              <span>{item.text}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="home-section" id="featured-publications">
        <h2>{copy.publicationsTitle}</h2>
        <div class="pub-featured" data-reveal>
          {featured.map((pub) => (
            <article class="pub-card">
              <div class="pub-card__media">
                <PublicationImage
                  src={pubCover(pub)}
                  alt={`${pub.title} — ${copy.publicationImageAlt}`}
                  widths={[240, 360, 480, 720]}
                  sizes="(max-width: 760px) calc(100vw - 40px), 320px"
                />
              </div>
              <div class="pub-card__body">
                <h3>
                  <a class="pub-card__title" href={`/publications/${pub.slug}/`}>
                    {pub.title}
                  </a>
                </h3>
                <p class="pub-card__venue">{pub.venue} · {pub.year}</p>
                <div class="pub-card__links">
                  {pub.code && (
                    <a href={pub.code} rel="noreferrer">
                      {copy.codeLabel} <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
        <div class="pub-featured__more" data-reveal>
          <a href="/publications/">
            {copy.allPublications} <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>

      <section class="home-section" id="recent-posts">
        <h2>{copy.writingTitle}</h2>
        {posts.length > 0 ? (
          <>
            <div class="post-list-v2" data-reveal>
              {posts.map((post) => (
                <a
                  class="post-row-v2 post-row-v2--link"
                  href={`/writing/${post.slug}/`}
                >
                  <time>{formatDate(post.data.publishedAt)}</time>
                  <span>{copy.postTitles[post.slug] ?? post.data.title}</span>
                  <span>
                    {copy.readLabel} <span aria-hidden="true">→</span>
                  </span>
                </a>
              ))}
            </div>
            <div class="writing-v2__more">
              <a href="/writing/">
                {copy.allWriting} <span aria-hidden="true">→</span>
              </a>
            </div>
          </>
        ) : (
          <div class="writing-empty" data-reveal>
            <p class="writing-empty__kicker">{copy.emptyKicker}</p>
            <h3>{copy.emptyTitle}</h3>
            <p>{copy.emptyText}</p>
          </div>
        )}
      </section>
    </div>
  </main>
</SiteLayout>
